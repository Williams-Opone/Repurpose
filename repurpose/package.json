    "jsdom": "^30.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "posthog-js": "^1.434.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.13.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
